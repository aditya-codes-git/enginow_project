# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration
MONGO_URI=mongodb://localhost:27017/enginow-events

# Security & Auth
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d
ACCESS_TOKEN_SECRET=super_secret_access_token_key_change_in_production
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_change_in_production
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Cloudinary Storage Configuration
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_secret

# Frontend Application URL for CORS
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

